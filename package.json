{
	"name": "effect-attio",
	"version": "0.4.0",
	"description": "Attio API SDK for Effect",
	"keywords": [
		"api",
		"attio",
		"effect",
		"sdk",
		"typescript"
	],
	"homepage": "https://github.com/tobimori/effect-attio",
	"bugs": {
		"url": "https://github.com/tobimori/effect-attio/issues"
	},
	"license": "MIT",
	"author": "Tobias Möritz <tobias@moeritz.io>",
	"repository": {
		"type": "git",
		"url": "https://github.com/tobimori/effect-attio.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "dist/index.js",
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*.js"
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "pnpm run clean && tsc",
		"test": "pnpm run build && pnpm run test:unit && pnpm run test:types",
		"test:unit": "tsc --project tsconfig.test.json && vitest run",
		"test:types": "tstyche --target '>=5.9'",
		"format": "oxfmt --write",
		"lint": "oxlint --fix --deny-warnings",
		"fix": "pnpm run lint && pnpm run format",
		"ci": "pnpm run fix && pnpm run test",
		"prepublishOnly": "pnpm run ci",
		"local-release": "changeset version && changeset publish",
		"changeset": "changeset",
		"release": "pnpm run build && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.6",
		"@effect/language-service": "^0.87.2",
		"effect": "4.0.0-rc.110",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"tstyche": "^7.2.2",
		"typescript": "^5.9.2",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"effect": "^4.0.0-rc.110"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.22.0"
}
